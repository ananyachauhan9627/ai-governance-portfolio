---
import Base from '../layouts/Base.astro';
import { projects } from '../lib/content.js';
const findings = [
  ['Critical', 'An optional add-on ', 'infers emotion from candidates’ faces and voices', ', a practice the EU AI Act prohibits.'],
  ['High', 'Applicant data ', 'trains a model shared with every other customer', ', by default.'],
  ['High', 'Summaries come from ', 'an upstream model nobody assessed', ', which can change without notice.'],
  ['High', 'Bias was ', 'tested once, on US applicants only', '.'],
  ['High', 'The bottom 40% are ', 'rejected automatically', ', without a recruiter looking.'],
];
import { site } from '../lib/site.js';
---
<Base description="Third-party risk and GRC professional assessing the AI that companies buy. Case studies in AI vendor risk, the EU AI Act and AI governance frameworks.">
  <section class="hero">
    <p class="intro"><b>Third-party risk &amp; AI governance.</b> Ex-KPMG Senior Consultant, top 5%. Open to TPRM, IT risk and AI governance roles in the Bay Area or remote. {site.workAuth}</p>
    <p class="kicker">A fictional case from my portfolio</p>
    <h1>Passed SOC 2. Failed the AI review.</h1>
    <p class="setup">Northwind Logistics wants to use Orrery Talent to rank job candidates in the US and Europe. Orrery has every certificate a vendor review asks for. Here is what the standard review saw, and what an AI review found.</p>

    <div class="reviews">
      <div class="col trad">
        <h2 class="section-label">Traditional vendor review</h2>
        <p class="meta">SIG-style security questionnaire</p>
        <ul>
          <li>SOC 2 Type II, no exceptions <span>Pass</span></li>
          <li>ISO 27001:2022 certificate <span>Pass</span></li>
          <li>Encryption and key management <span>Pass</span></li>
          <li>Access control and SSO <span>Pass</span></li>
          <li>Business continuity <span>Pass</span></li>
        </ul>
        <p class="verdict">Approved.</p>
      </div>
      <div class="col ai" id="ai">
        <h2 class="section-label">AI review</h2>
        <p class="meta">32 questions across eight AI risk domains</p>
        <ul>
          {findings.map(([sev, a, m, b]) => (
            <li><span class="sev">{sev}</span><span class="txt">{a}<mark>{m}</mark>{b}</span></li>
          ))}
        </ul>
        <p class="verdict"><b>Not approved for production.</b> Overall control score 45%, residual risk high.</p>
        <a class="read" href="/work/ai-vendor-risk-assessment">Read the full assessment</a>
      </div>
    </div>
  </section>

  <section class="about">
    <div class="who">
      <h2 class="section-label">About</h2>
      <img class="portrait" src="/ananya-chauhan.jpg" alt="Ananya Chauhan" width="200" height="200" loading="lazy">
    </div>
    <div>
      <p class="big">Most organizations will govern AI they buy, not AI they build. My work is making sure the vendor review catches what matters.</p>
      <p>I’m a GRC and third-party risk professional. As a Senior Consultant at KPMG, rated in the top 5% of consultants, I assessed more than 200 vendors and co-led the rollout of a vendor assessment tool now used by over 100 KPMG clients. I’m now extending that practice to AI through the Graduate Certificate in Ethical AI at San Francisco State University and the projects below.</p>
      <p><a href="/about">Experience, certifications and education</a></p>
    </div>
  </section>

  <section class="work" id="work">
    <h2 class="section-label">Work</h2>
    {projects.map((p) => (
      <a class="entry" href={`/work/${p.slug}`}>
        <span class="label">{p.label}</span>
        <div>
          <h3>{p.title}{p.status && <span class="badge">{p.status}</span>}</h3>
          <p>{p.summary}</p>
        </div>
      </a>
    ))}
  </section>
</Base>

<style>
  .hero{padding:44px 0 40px}
  .intro{font:400 17px/1.5 var(--sans);color:var(--grey);max-width:62ch;padding-bottom:36px;margin-bottom:36px;border-bottom:1px solid var(--rule)}
  .intro b{color:var(--ink)}
  h1{font:500 clamp(44px,7.2vw,96px)/.98 var(--serif);letter-spacing:-.025em;margin-top:14px;max-width:14ch}
  .setup{font-size:21px;line-height:1.5;color:var(--grey);margin-top:28px;max-width:52ch}
  .reviews{display:grid;grid-template-columns:1fr 1.4fr;margin-top:48px;border-top:2px solid var(--ink)}
  .col{padding:24px 0}
  .col:first-child{padding-right:40px}
  .col + .col{padding-left:40px;border-left:1px solid var(--rule)}
  .meta{font:400 14px var(--sans);color:var(--grey);margin-top:2px}
  ul{list-style:none;padding:0;margin-top:18px}
  .trad li{display:flex;justify-content:space-between;gap:16px;padding:9px 0;border-bottom:1px solid var(--rule);font:400 16px var(--sans);color:var(--grey)}
  .trad li span{color:var(--pass);font-weight:700}
  .verdict{margin-top:18px;font-size:17px}
  .ai li{display:grid;grid-template-columns:5.2rem 1fr;gap:14px;padding:12px 0;border-bottom:1px solid var(--rule)}
  .sev{font:700 13px/1.9 var(--sans);color:var(--red)}
  .txt{font-size:18px;line-height:1.45}
  mark{background:linear-gradient(var(--mark),var(--mark)) no-repeat 0 85%/0% 55%;color:inherit;padding:0 2px;transition:background-size .7s cubic-bezier(.3,.7,.2,1)}
  :global(.ai.on) mark{background-size:100% 55%}
  .ai .verdict{color:var(--red)}
  .read{display:inline-block;margin-top:14px;font:700 16px var(--sans);text-underline-offset:5px}
  .about{display:grid;grid-template-columns:1fr 2fr;gap:40px;padding:72px 0;border-top:1px solid var(--rule);margin-top:56px}
  .portrait{display:block;width:200px;height:200px;object-fit:cover;margin-top:20px;filter:saturate(.85)}
  .about p{color:var(--grey);max-width:58ch;margin-top:16px}
  .about p.big{font-size:22px;line-height:1.5;color:var(--ink);margin-top:0;max-width:46ch}
  .about a{font:700 16px var(--sans);color:var(--ink);text-underline-offset:5px}
  .work{padding:56px 0 0;border-top:1px solid var(--rule)}
  .entry{display:grid;grid-template-columns:1fr 2fr;gap:40px;padding:32px 0;border-bottom:1px solid var(--rule);text-decoration:none}
  .label{font:400 15px var(--sans);color:var(--grey)}
  .entry h3{font:500 30px/1.15 var(--serif);letter-spacing:-.01em}
  .entry h3 .badge{margin-left:10px}
  .entry p{margin-top:10px;color:var(--grey);max-width:56ch}
  .entry:hover h3{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:6px}
  @media (max-width:820px){
    .reviews,.about,.entry{grid-template-columns:1fr;gap:12px}
    .portrait{width:140px;height:140px;margin-bottom:12px}
    .col:first-child{padding-right:0}
    .col + .col{padding-left:0;border-left:0;border-top:1px solid var(--rule)}
  }
</style>
<script is:inline>
  const ai = document.getElementById('ai');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (ai) {
    const io = new IntersectionObserver((e) => {
      if (!e[0].isIntersecting) return;
      if (!reduce) ai.querySelectorAll('mark').forEach((m, i) => (m.style.transitionDelay = 300 + i * 350 + 'ms'));
      ai.classList.add('on'); io.disconnect();
    }, { threshold: 0.3 });
    io.observe(ai);
  }
</script>
